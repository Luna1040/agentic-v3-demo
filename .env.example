# 真实模式使用 Kaon Router；demo 仅用于离线开发，仍需 PostgreSQL。
MODEL_MODE=live
PORT=7633
# 独立本机 demo 的开发台；官方宿主须注入自己的开发权限判定。
ENABLE_DEVELOPER_TOOLS=true

# 密钥只保存在后端 .env 或部署环境，不能提交。
KAON_BASE_URL=https://kaon-router.kaonai.com/v1
KAON_MODEL=kaon/gemini-3.8-flash
# 后台主线/动态开场；普通聊天首字前不调用 Main。
KAON_MAIN_MODEL=kaon/claude-opus-4-8
KAON_API_KEY=
# 事件提取、去重与离线整理，模型仅提候选，由代码校验提交。
KAON_UPDATER_MODEL=kaon/gpt-5.6-luna
KAON_TIMEOUT_MS=90000

# db:setup 会生成忽略提交的本地连接配置，无需手填密码。
# 部署时显式配置不同的应用账号和迁移账号：
# DATABASE_URL=postgresql://app:password@127.0.0.1:55432/agentic_v3
# MIGRATION_DATABASE_URL=postgresql://migrator:password@127.0.0.1:55432/agentic_v3
# TEST_DATABASE_URL=postgresql://test_app:password@127.0.0.1:55432/agentic_v3_test
# TEST_MIGRATION_DATABASE_URL=postgresql://test_migrator:password@127.0.0.1:55432/agentic_v3_test
DB_POOL_MAX=10

# 默认指向并列工程 Desktop/roleplay-harness，可按部署位置覆盖。
# HARNESS_ROOT=C:/Users/11043/Desktop/roleplay-harness
# HARNESS_MODULE_PATH=C:/path/to/roleplay-harness/dist/apps/agentic-v3/index.js
